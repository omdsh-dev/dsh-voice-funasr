{
  "name": "dsh-voice-funasr",
  "version": "0.1.1",
  "description": "DSH web plugin: local offline FunASR voice input (paraformer int8 onnx sidecar, Web Speech fallback, LLM polish).",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "python",
    "cordis.patch.yml",
    "src"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.json && tsdown",
    "dev:link-dsh": "node scripts/link-dsh-workspace.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:python": "node scripts/test-python.mjs",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run test:python && pnpm run build",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run verify"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1 <4.1.0",
    "@deepseek-ai/dsh-agent-default-model": ">=0.0.1-rc.2 <0.0.2",
    "@deepseek-ai/dsh-client-connection": ">=0.0.1-rc.2 <0.0.2",
    "@deepseek-ai/dsh-client-locale": ">=0.0.1-rc.2 <0.0.2",
    "@deepseek-ai/dsh-client-runtime": ">=0.0.1-rc.2 <0.0.2",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.0.1-rc.2 <0.0.2",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.0.1-rc.2 <0.0.2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.0.1-rc.2 <0.0.2",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc.2 <0.0.2",
    "@deepseek-ai/dsh-subprocess": ">=0.0.1-rc.2 <0.0.2",
    "@deepseek-ai/schemastery": ">=3.18.1-rc.1 <3.19.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-default-model": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-subprocess": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "lightningcss": "^1.32.0",
    "react": "^18.2.0",
    "react-dom": "18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  }
}
